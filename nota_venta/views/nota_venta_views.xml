<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_nota_venta" model="ir.actions.act_window">
            <field name="name">Notas de Ventas</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('journal_id.code', '=', 'NV'), ('move_type', '=', 'out_invoice')]</field>
            <field name="context">{
                'default_move_type': 'out_invoice',
                'search_default_is_nota_venta': 1,
                'journal_type': 'sale',
                'default_is_nota_venta': True,
            }</field>
        </record>

        <record id="view_nota_venta_form_inherit" model="ir.ui.view">
            <field name="name">nota.venta.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_type'][@widget='receipt_selector']" position="attributes">
                    <attribute name="invisible">context.get('default_is_nota_venta', False)</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
