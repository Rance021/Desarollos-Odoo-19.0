<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_temperature_wizard_form" model="ir.ui.view">
        <field name="name">stock.temperature.wizard.form</field>
        <field name="model">stock.temperature.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Temperatura">
                <sheet>
                    <group>
                        <group string="Identificación">
                            <field name="origin_type" widget="radio" readonly="1"/>
                            <field name="picking_id" readonly="1"
                                   invisible="origin_type != 'reception'"/>
                            <field name="quant_id" readonly="1"
                                   invisible="origin_type != 'inventory'"/>
                            <field name="production_id" readonly="1"
                                   invisible="origin_type != 'manufacturing'"/>
                            <field name="date"/>
                        </group>
                        <group string="Producto (opcional)">
                            <field name="product_id"/>
                            <field name="lot_id" invisible="not product_id"/>
                        </group>
                    </group>
                    <group string="Lectura principal">
                        <group>
                            <field name="temperature"/>
                            <field name="temperature_unit" widget="radio" class="oe_inline"/>
                        </group>
                    </group>
                    <separator string="Puntos adicionales de medición"/>
                    <field name="line_ids" widget="one2many">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="description" placeholder="Ej: Entrada del camión"/>
                            <field name="temperature"/>
                            <field name="notes" placeholder="Observación"/>
                        </list>
                    </field>
                    <group>
                        <field name="notes" placeholder="Observaciones generales..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" string="Guardar y Confirmar"
                            type="object" class="btn-primary"/>
                    <button name="action_save_and_new" string="Guardar y Nueva Lectura"
                            type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
