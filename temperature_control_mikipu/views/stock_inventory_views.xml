<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_temperature_form" model="ir.ui.view">
        <field name="name">stock.quant.temperature.form</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="temperature_log_count" string="Registros de Temperatura"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
