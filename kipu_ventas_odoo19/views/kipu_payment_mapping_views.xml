<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kipu_payment_mapping_form" model="ir.ui.view">
        <field name="name">kipu.payment.mapping.form</field>
        <field name="model">kipu.payment.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapeo de Pago Kipu">
                <sheet>
                    <group>
                        <field name="nombre_forma_pago"/>
                        <field name="journal_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kipu_payment_mapping_list" model="ir.ui.view">
        <field name="name">kipu.payment.mapping.list</field>
        <field name="model">kipu.payment.mapping</field>
        <field name="arch" type="xml">
            <list string="Mapeo de Pagos Kipu" editable="bottom">
                <field name="nombre_forma_pago"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_kipu_payment_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo de Pagos Kipu</field>
        <field name="res_model">kipu.payment.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
