<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_kipu_inherit" model="ir.ui.view">
        <field name="name">account.move.form.kipu.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="kipu_reference" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
